  html = {https://doi.org/10.1016/B978-0-443-15378-5.00021-8},
  preview ={Phad_BookChapter_frontpage_page-0001.jpg},
  abstract = {The development of effective viral vaccines has been a cornerstone of modern medicine. Over recent years, innovative approaches have revolutionized the field of vaccine development by diminishing the effects of infections and saving countless lives in the process. Although traditional vaccine technologies have been used to combat a variety of bacterial and viral pathogens, there exist instances where these conventional methods have encountered challenges in cases involving complex viral antigens, persistent infections, and fast-mutating pathogens characterized by substantial genetic variation. This chapter explores the latest frontiers in viral vaccine development, focusing on DNA vaccines, mRNA vaccines, protein subunit vaccines, the novel technologies of vaccine development by reverse genetics approaches, and reverse vaccinology. These emerging technologies hold the promise of faster, safer, and more adaptable solutions to combat both existing and emerging viral threats. Through a comprehensive examination of these novel approaches, we aim to provide insights into the future of viral vaccine development.}
  }

 @article{adma202314206,
abbr={Wiley},
author = {Das, Jaysri and Phad, Vedant and Saha, Debopriya and Dutta, Sayonti and Dhabal, Debdas and Manna, Uttam},
title = {Facilitating electrochemical overall water splitting through tailoring ionic environment and gas-bubble wettability},
journal = {Advanced Materials},
pages = {},
year = {2025},
preview={adma.gif},
html = {},
pdf = {},
dimensions={true},
google_scholar_id={},
abstract = {Unwanted gas bubble adhesion at electrode surface and its unfavourable microenvironment compromising(compromise) water splitting performance by perturbing the access of electrolytes and electron transfer process. While reported bubble-repellent coatings promote an early detachment of gas bubbles—they mostly fail to provide a favourable microenvironment for overall electrochemical water-splitting. Here, we have experimentally and theoretically validated the impact of the synergistic association of bubble repellence and selective ionic environments on water splitting performance. For capillary force-dominated early gas bubbles departure scenario, extreme bubble repellent coatings decorated with cationic and anionic moieties provided superior performance for HER and OER, respectively. Eventually, this non-catalytic and universal strategy improves gas (hydrogen and oxygen) bubbles production by > 60%, compared to bare electrode at identical experimental conditions, and its strategic utilization depletes the required voltage for overall water splitting by ~ 50% at a current density of 100 mA cm-2.}
}



